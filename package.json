{
  "name": "h3-motionstudio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8111 --reload",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
