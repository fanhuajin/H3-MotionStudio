{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "song_name": { "type": "string" },
    "song_mood": { "type": "string" },
    "style_source": { "type": "string", "enum": ["video", "redesign"] },
    "title": { "type": "string" },
    "introduction": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 5, "maxItems": 5 },
    "remove_subtitles": { "type": "boolean" },
    "content_prompt": { "type": "string" },
    "video_prompt": { "type": "string" },
    "image_prompt": { "type": "string" },
    "action_prompt": { "type": "string" },
    "camera_prompt": { "type": "string" }
  },
  "required": [
    "song_name",
    "song_mood",
    "style_source",
    "title",
    "introduction",
    "tags",
    "remove_subtitles",
    "content_prompt",
    "video_prompt",
    "image_prompt",
    "action_prompt",
    "camera_prompt"
  ]
}
