{
  "manifest_version": 3,
  "name": "H3 抖音选片助手",
  "version": "1.0.3",
  "description": "在抖音网页勾选跳舞视频，一次复制全部链接后手动提交到 H3。",
  "permissions": ["storage"],
  "action": { "default_title": "开启 / 关闭 H3 选片助手" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.douyin.com/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
